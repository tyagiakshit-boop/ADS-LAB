#include <iostream>
#include <stack>
using namespace std;

int main() {
    string str;
    stack<char> s;

    cout << "Enter a string: ";
    cin >> str;

   
    for (char ch : str) {
        s.push(ch);
    }

    
    bool palindrome = true;

    for (char ch : str) {
        if (ch != s.top()) {
            palindrome = false;
            break;
        }
        s.pop();
    }

    if (palindrome)
        cout << "The string is a palindrome." << endl;
    else
        cout << "The string is not a palindrome." << endl;

    return 0;
}
